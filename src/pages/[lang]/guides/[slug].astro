---
import { render } from 'astro:content';
import NotWritten from '../../../components/NotWritten.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import AffiliateDisclosure from '../../../components/AffiliateDisclosure.astro';
import SourceList from '../../../components/SourceList.astro';
import { LANGS, t, type Lang } from '../../../i18n/ui';
import { url, docs } from '../../../lib/content';
import { breadcrumbSchema, articleSchema } from '../../../lib/seo';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    for (const entry of await docs('guides', lang)) {
      paths.push({ params: { lang, slug: entry.data.slug }, props: { entry } });
    }
  }
  return paths;
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const { Content } = await render(entry);
/* `stage: draft` تعني: الهيكل قائم والنصّ لم يُكتب. تُعرض للزائر
   كصفحة تقول ذلك صراحةً، ولا تدخل نتائج البحث. */
const notWritten = entry.data.stage === 'draft';

const solutions = await docs('solutions', lang);
const parent = solutions.find((s) => s.data.problem_id === entry.data.solution);
const here = url.guide(lang, entry.data.slug);
const crumbs = [
  { name: tr('site.name'), url: url.home(lang) },
  { name: tr('nav.guides'), url: url.guides(lang) },
  { name: entry.data.title, url: here },
];
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  path={here}
  noindex={entry.data.noindex || notWritten}
  schema={[breadcrumbSchema(crumbs), articleSchema({ ...entry.data, url: here })]}
>
  <Breadcrumbs items={crumbs} />

  <div class="wrap stack page-body">
    {/* لا إفصاح تجاري على صفحة لا تبيع شيئاً — يربك القارئ ويضعف الإفصاح نفسه. */}
    {!notWritten && <AffiliateDisclosure lang={lang} />}

    <header class="page-head">
      <div class="charge" style="--fill:50%;max-width:5rem;" aria-hidden="true"></div>
      <h1>{entry.data.title}</h1>
      <p class="lead lead-lg">{entry.data.description}</p>
      <p class="source">{tr('meta.updated')} {entry.data.updated.toISOString().slice(0, 10)}</p>
      {parent && <p><a href={url.solution(lang, parent.data.slug)}>← {parent.data.question}</a></p>}
    </header>

    {entry.data.hero_image && (
      <figure class="hero-figure">
        <img src={entry.data.hero_image} alt={entry.data.hero_image_alt ?? ''} width="1400" height="647" loading="eager" />
        <figcaption>{tr('handson.photos')}</figcaption>
      </figure>
    )}

    {notWritten ? <NotWritten lang={lang} topic={entry.data.title} /> : <div class="prose"><Content /></div>}

    <SourceList sources={entry.data.sources} lang={lang} />

    <div class="stack">
      {entry.data.picks.map((pick) => (
        <ProductCard id={pick.product} lang={lang} badge={pick.badge} reason={pick.reason} />
      ))}
    </div>
  </div>
</BaseLayout>
