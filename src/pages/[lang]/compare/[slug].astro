---
import { render } from 'astro:content';
import NotWritten from '../../../components/NotWritten.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CompareTable from '../../../components/CompareTable.astro';
import AffiliateDisclosure from '../../../components/AffiliateDisclosure.astro';
import SourceList from '../../../components/SourceList.astro';
import { LANGS, t, type Lang } from '../../../i18n/ui';
import { url, docs } from '../../../lib/content';
import { breadcrumbSchema, articleSchema } from '../../../lib/seo';
import { isNotWritten, isAwaitingReview } from '../../../lib/review-codes';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    for (const entry of await docs('comparisons', lang)) {
      paths.push({ params: { lang, slug: entry.data.slug }, props: { entry } });
    }
  }
  return paths;
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const { Content } = await render(entry);
/* Two independent fields:
     published  is the URL live?
     stage      how far has the text got?
   `draft` (skeleton) renders as a page that says it is not written yet,
   marked noindex. `written` (awaiting review) does too after launch; until
   then, and in the preview build, it shows its text under a "waiting for
   review" banner, still noindex (src/lib/review-codes.ts). */
const notWritten = isNotWritten(entry.data.stage);
const awaitingReview = isAwaitingReview(entry.data.stage);

const solutions = await docs('solutions', lang);
const parent = solutions.find((s) => s.data.problem_id === entry.data.solution);
const here = url.comparison(lang, entry.data.slug);
const crumbs = [
  { name: tr('site.name'), url: url.home(lang) },
  { name: tr('nav.compare'), url: url.comparisons(lang) },
  { name: entry.data.title, url: here },
];
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  path={here}
  noindex={entry.data.noindex || notWritten || awaitingReview}
  schema={[breadcrumbSchema(crumbs), articleSchema({ ...entry.data, url: here })]}
>
  <Breadcrumbs items={crumbs} />

  <div class="wrap stack page-body">
    {awaitingReview && <p class="review-banner" role="note">{tr('review.pending')}</p>}
    {/* No disclosure on a page that sells nothing — it would confuse readers and weaken the disclosure everywhere else. */}
    {!notWritten && <AffiliateDisclosure lang={lang} />}

    <header class="page-head">
      <div class="charge" style="--fill:50%;max-width:5rem;" aria-hidden="true"></div>
      <h1>{entry.data.title}</h1>
      <p class="lead lead-lg">{entry.data.description}</p>
      <p class="source">{tr('meta.updated')} {entry.data.updated.toISOString().slice(0, 10)}</p>
      {parent && <p><a href={url.solution(lang, parent.data.slug)}>← {parent.data.question}</a></p>}
    </header>

    {!notWritten && <CompareTable ids={entry.data.products} lang={lang} />}

    {notWritten ? <NotWritten lang={lang} topic={entry.data.title} /> : <div class="prose"><Content /></div>}

    <SourceList sources={entry.data.sources} lang={lang} />

    <section class="panel">
      <h2 class="panel-title">{tr('compare.verdict')}</h2>
      <p>{entry.data.verdict}</p>
    </section>
  </div>
</BaseLayout>
