---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { t, type Lang } from '../../../i18n/ui';
import { url } from '../../../lib/content';
import { breadcrumbSchema } from '../../../lib/seo';

export async function getStaticPaths() {
  const all = await getCollection('pages');
  return all
    .filter((p) => p.data.published)
    .map((entry) => ({ params: { lang: entry.data.lang, slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const { Content } = await render(entry);
const here = url.info(lang, entry.data.slug);
const crumbs = [{ name: tr('site.name'), url: url.home(lang) }, { name: entry.data.title, url: here }];
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description} path={here} schema={[breadcrumbSchema(crumbs)]}>
  <Breadcrumbs items={crumbs} />
  <div class="wrap page-body">
    <header class="page-head">
      <div class="charge" style="--fill:38%" aria-hidden="true"></div>
      <h1>{entry.data.title}</h1>
      <p class="source">{tr('meta.updated')} {entry.data.updated.toISOString().slice(0, 10)}</p>
    </header>
    <div class="prose"><Content /></div>
  </div>
</BaseLayout>
