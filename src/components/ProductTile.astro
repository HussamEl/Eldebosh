---
/* Compact product tile for the home page grid and the market-stall page.
   Works without a photo: the most important number in the specs becomes the
   visual. Amazon images are only allowed through its API (after three
   qualifying sales), and retailer photos may never be copied. */
import { t, type Lang } from '../i18n/ui';
import { affiliateHref, affiliateNetwork, type Product } from '../lib/content';
import { gearGroup } from '../lib/gear-groups';
import { SHOW_REVIEW_CODES, photoCode } from '../lib/review-codes';

interface Props { product: Product; lang: Lang; }
const { product: p, lang } = Astro.props;
const tr = t(lang);
/* A product not yet verified (verified: false) is shown only because we own it
   and photographed it: photo and name, nothing that needs a source — no
   specs, no price band, no buy link (EB-019, RULES 2.4). */
const listed = p.verified === true;
const href = listed ? affiliateHref(p) : null;
const viewerId = `v-${p.code ?? p.id}`;

/* The hero number: the first spec that starts with a digit. */
const specs = Object.entries(p.key_specs);
const numeric = !listed ? undefined : specs.find(([, v]) => /^\s*\d/.test(String(v)));
const m = numeric ? String(numeric[1]).match(/^\s*([\d\s.,]+)\s*(.*)$/) : null;

const heroValue = m ? m[1].trim() : null;
const heroUnit = m ? m[2].trim().slice(0, 8) : '';
const heroLabel = numeric ? numeric[0] : '';

/* Chips: the next specs, long values shortened. */
const photos = p.own_photos.slice(0, 3);
const chips = !listed ? [] : specs
  .filter(([k]) => k !== heroLabel)
  .slice(0, 2)
  .map(([k, v]) => [k, String(v).length > 18 ? String(v).slice(0, 17) + '…' : String(v)] as const);

/* The tile face is a link to the photo viewer when we have photos, otherwise a
   direct buy link when there is one, otherwise plain. Rendered as a real
   element so Astro escapes every attribute. */
const faceAttrs: Record<string, string> = photos.length
  ? { href: `#${viewerId}`, 'aria-label': tr('viewer.open') }
  : href
    ? { href, rel: 'sponsored nofollow noopener', target: '_blank', 'data-affiliate': p.id, 'data-network': affiliateNetwork(p) }
    : {};
const Face = photos.length || href ? 'a' : 'div';
---

<article
  id={`t-${p.code ?? p.id}`}
  class="tile"
  data-category={gearGroup(p) ?? ''}
  data-band={p.price_band}
  data-tested={String(p.tested)}
  data-name={`${p.brand} ${p.name}`.toLowerCase()}
>
  <Face class="tile-face" {...faceAttrs}>
    {photos.length > 0 ? (
      <span class="tile-photos" data-n={photos.length}>
        {photos.map((ph, i) => (
          <img
            class="tile-photo"
            src={ph.src}
            alt={i === 0 ? ph.alt : ''}
            aria-hidden={i > 0 ? 'true' : undefined}
            loading="lazy"
            width="360"
            height="360"
            decoding="async"
            style={`--i:${i}`}
          />
        ))}
      </span>
    ) : heroValue ? (
      <>
        <span class="tile-hero" aria-hidden="true">
          <span class="tile-hero-value">{heroValue}</span>
          {heroUnit && <span class="tile-hero-unit">{heroUnit}</span>}
        </span>
        <span class="tile-hero-label">{heroLabel}</span>
      </>
    ) : (
      <span class="tile-mono" aria-hidden="true">{p.brand.slice(0, 2).toUpperCase()}</span>
    )}
  </Face>

  <div class="tile-body">
    <p class="tile-brand">
      {p.brand}
      {SHOW_REVIEW_CODES && p.code && <span class="review-code">{p.code}</span>}
      {p.tested && <span class="tile-dot" title={tr('trust.tested')} aria-label={tr('trust.tested')}></span>}
    </p>
    <h3 class="tile-name">{p.name}</h3>

    {chips.length > 0 && (
      <ul class="tile-chips">
        {chips.map(([k, v]) => <li><b>{v}</b> {k}</li>)}
      </ul>
    )}

    <p class="tile-band">
      {listed && tr(`price.${p.price_band}` as any)}
      {p.tested && <span class="tile-torget">{tr('torget.badge')}</span>}
    </p>

    {href ? (
      <a class="tile-cta" href={href} rel="sponsored nofollow noopener" target="_blank" data-affiliate={p.id} data-network={affiliateNetwork(p)}>
        {tr('tile.cta')}
      </a>
    ) : (
      <span class="tile-cta is-soon">{tr('tile.soon')}</span>
    )}
  </div>

  {photos.length > 0 && (
    <div class="viewer" id={viewerId}>
      <a class="viewer-veil" href={`#t-${p.code ?? p.id}`} aria-label={tr('viewer.close')}></a>
      <div class="viewer-box">
        <a class="viewer-close" href={`#t-${p.code ?? p.id}`} aria-label={tr('viewer.close')}>×</a>
        <p class="viewer-title">{p.brand} · {p.name}</p>
        <div class="viewer-shots">
          {photos.map((ph) => (
            <figure>
              <img src={ph.src} alt={ph.alt} loading="lazy" width="720" height="720" decoding="async" />
              {ph.caption && <figcaption>{ph.caption}</figcaption>}
              {SHOW_REVIEW_CODES && photoCode(ph.src) && <span class="review-code">{photoCode(ph.src)}</span>}
            </figure>
          ))}
        </div>
        {href && (
          <a class="btn btn-volt viewer-buy" href={href} rel="sponsored nofollow noopener" target="_blank" data-affiliate={p.id} data-network={affiliateNetwork(p)}>
            {tr('tile.cta')}
          </a>
        )}
      </div>
    </div>
  )}
</article>
