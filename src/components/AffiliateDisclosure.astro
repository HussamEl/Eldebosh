---
/* Required at the top of every page with buy links (Swedish Marketing Act,
   Marknadsföringslagen). Never moved to the footer or hidden behind a button. */
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);
---
<aside class="disclosure" data-pagefind-ignore>
  <b>{tr('disclosure.label')}</b>
  {tr('disclosure.short')}
  <span class="amazon-line">{tr('amazon.disclosure')}</span>
</aside>
