---
/* الجزيرة التفاعلية الوحيدة — تصفية المنتجات حسب المجموعة.
   بلا سكربت: كل المنتجات تظهر والشريط مخفي.
   الأزرار مجموعات لا فئات بيانات — انظر `src/lib/gear-groups.ts` و`D-030`. */
import { t, type Lang } from '../i18n/ui';
import type { GearGroupId } from '../lib/gear-groups';

interface Props { lang: Lang; groups: readonly { id: GearGroupId; count: number }[]; total: number; }
const { lang, groups, total } = Astro.props;
const tr = t(lang);
---

<div class="gearbar" data-gearbar hidden>
  <div class="gearbar-chips" role="group" aria-label={tr('filter.label')}>
    <button type="button" class="chip is-on" data-filter="all" aria-pressed="true">
      {tr('filter.all')} <span class="chip-n">{total}</span>
    </button>
    {groups.map((g) => (
      <button type="button" class="chip" data-filter={g.id} aria-pressed="false">
        {tr(`filter.group.${g.id}`)} <span class="chip-n">{g.count}</span>
      </button>
    ))}
  </div>
</div>

<p class="gear-count" data-gear-count hidden aria-live="polite"></p>
