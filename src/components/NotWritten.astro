---
/* The page exists; its text is not written yet.
 *
 * The owner's decision: keep the site's full structure visible, and tell the
 * visitor plainly when a section is not written, rather than hide it.
 *
 * Three constraints:
 *   1. Always noindex: a page without content stays out of search results.
 *   2. No product and no buy link: it sells nothing.
 *   3. The invitation to write to us is e-mail and SMS links — no form, nothing
 *      stored — so the privacy policy is unaffected.
 * And a skeleton older than 90 days fails the build (scripts/validate.mjs).
 */
import { getCollection } from 'astro:content';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang; topic: string; }
const { lang, topic } = Astro.props;
const tr = t(lang);

const subject = encodeURIComponent(`${tr('notwritten.subject')}: ${topic}`);
const mail = `mailto:info@eldebosh.com?subject=${subject}`;
const torget = (await getCollection('torget'))[0];
const sms = `sms:${torget.data.phone}`;
---

<section class="notwritten panel">
  <h2 class="panel-title">{tr('notwritten.title')}</h2>
  <p>{tr('notwritten.lead')}</p>
  <p>{tr('notwritten.ask')}</p>
  <div class="notwritten-actions">
    <a class="btn btn-volt" href={mail}>{tr('notwritten.mail')}</a>
    <a class="btn btn-ghost" href={sms}>{tr('notwritten.sms')}</a>
  </div>
  <p class="source">{tr('notwritten.note')}</p>
</section>
