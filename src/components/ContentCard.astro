---
import Icon from './Icon.astro';
import { PREVIEW } from '../lib/preview';
import { t, type Lang } from '../i18n/ui';
interface Props { title: string; href: string; description?: string; tag?: string; problem?: boolean; icon?: string; draft?: boolean; notWritten?: boolean; }
const { title, href, description, tag, problem = false, icon, draft = false, notWritten = false } = Astro.props;
/* Preview only: the published build never contains unpublished pages, but the
   preview does, and must not present them as live. */
const showDraft = PREVIEW && draft;
const tr = t((Astro.params.lang as Lang) ?? 'sv');
---
<article class={`card card-link${problem ? ' problem-card' : ''}`}>
  {icon && (
    <span class="card-icon" aria-hidden="true"><Icon name={icon} size={22} /></span>
  )}
  {problem && <div class="charge" aria-hidden="true"></div>}
  {tag && !problem && <span class="tag">{tag}</span>}
  {showDraft && <span class="tag tag-draft">Utkast — inte på sajten</span>}
  {notWritten && <span class="tag tag-soon">{tr('notwritten.badge')}</span>}
  <h3><a class="stretch" href={href}>{title}</a></h3>
  {description && <p>{description}</p>}
</article>
