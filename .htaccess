# Server configuration for the static site (Apache/LiteSpeed on Hostinger).
#
# This file replaces any .htaccess left from an earlier WordPress install:
# WordPress routes every request to index.php, which breaks a static site.
# There are no rewrite rules here — the server serves files as they are.

DirectoryIndex index.html

# ---------- error page ----------
ErrorDocument 404 /sv/

# ---------- compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- caching ----------
<IfModule mod_expires.c>
  ExpiresActive On

  # `immutable` promises the browser that this exact URL will never change.
  # True for _astro/* (the content hash is in the file name) and for fonts.
  # Not for a fixed-path script such as /js/eldebosh-ui.js, which carries its
  # hash in the URL instead (src/lib/asset-hash.ts) and so gets no promise.
  <FilesMatch "\.(css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>

  # scripts at a fixed path — the hash is in the URL, not the name
  <FilesMatch "\.js$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # images
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>

  # pages — revalidated on every visit, so a deploy is seen at once
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- basic hardening ----------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# no directory listings
Options -Indexes
